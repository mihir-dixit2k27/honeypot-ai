# Honeypot-AI — Environment Variables
# Copy to .env and fill in your values.

# Path to the Cowrie NDJSON log file
HONEYPOT_AI_LOG=cowrie/var/log/cowrie/cowrie.json

# Anomaly detection sensitivity (0.01 – 0.50)
HONEYPOT_AI_CONTAMINATION=0.05

# GeoIP enrichment (true/false)
HONEYPOT_AI_GEO=true

# Output directory for reports and CSVs
HONEYPOT_AI_OUTPUT=output
